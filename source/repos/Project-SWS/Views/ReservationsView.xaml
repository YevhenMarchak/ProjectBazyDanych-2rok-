<UserControl x:Class="Project_SWS.Views.ReservationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="450" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Klient:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding NewResClient}" DisplayMemberPath="LastName" Width="120" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Auto:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox ItemsSource="{Binding Cars}" SelectedItem="{Binding NewResCar}" DisplayMemberPath="Model" Width="120" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Od:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding NewResStart}" Width="100" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

            <TextBlock Text="Do:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding NewResEnd}" Width="100" Margin="0,0,15,0" VerticalContentAlignment="Center"/>

            <Button Content="Dodaj" Command="{Binding AddReservationCommand}" Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Usuń" Command="{Binding DeleteReservationCommand}" Padding="10,5" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Header="Klient (Nazwisko)" Binding="{Binding Client.LastName}" />
                <DataGridTextColumn Header="Auto (Model)" Binding="{Binding Car.Model}" />
                <DataGridTextColumn Header="Data od" Binding="{Binding StartDate, StringFormat=d}" />
                <DataGridTextColumn Header="Data do" Binding="{Binding EndDate, StringFormat=d}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>