<Window x:Class="Project_SWS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Project_SWS.ViewModels"
        xmlns:views="clr-namespace:Project_SWS.Views"
        Title="System Wypożyczalni Samochodów" Height="600" Width="1000">

    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#EEEEEE" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="SWS SYSTEM" FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,30" />

                <Button Content="🚗 Flota Samochodowa" Command="{Binding NavigateCarsCommand}" Margin="10,5" Height="45" FontSize="14" />
                <Button Content="👥 Baza Klientów" Command="{Binding NavigateClientsCommand}" Margin="10,5" Height="45" FontSize="14" />
                <Button Content="📅 Rezerwacje" Command="{Binding NavigateReservationsCommand}" Margin="10,5" Height="45" FontSize="14" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="15" />
    </Grid>

</Window>